# ==============================================================================
# Fake Job Detection & Verification Platform - Backend Environment Configuration
# ==============================================================================

# Application Settings
APP_NAME=FakeJobDetectionPlatform
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (Comma-separated list)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database Configuration
# Default: SQLite for immediate local development without extra setup
DATABASE_URL=sqlite:///./fake_jobs.db

# PostgreSQL Production Example (Uncomment and configure if using PostgreSQL):
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/fakejobdb

# Machine Learning Artifacts
MODEL_PATH=../models/fake_job_detector.joblib
DATASET_PATH=../data/emscad_dataset.csv

# Security & Scraping Safeguards
MAX_CONTENT_LENGTH_BYTES=2097152
REQUEST_TIMEOUT_SECONDS=8
USER_AGENT=FakeJobVerifierBot/1.0 (+https://fakejobverifier.local/bot)

# Optional External API Keys (Leave blank for autonomous heuristic & registry mode)
# CLEARBIT_API_KEY=
# HUNTER_IO_API_KEY=
