# ==============================================================================
# Fake Job Detection Platform - Global Environment Configuration
# ==============================================================================

# Backend Application Settings
APP_NAME=FakeJobDetectionPlatform
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database Settings
# Default: SQLite for immediate plug-and-play local development
DATABASE_URL=sqlite:///./fake_jobs.db

# PostgreSQL Production Setup (Uncomment to use PostgreSQL):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fakejobdb

# Machine Learning Paths
MODEL_PATH=../models/fake_job_detector.joblib
DATASET_PATH=../data/emscad_dataset.csv
SEED_DATASET_PATH=../data/seed_jobs.csv

# Security & Scraping Controls
MAX_CONTENT_LENGTH_BYTES=2097152
REQUEST_TIMEOUT_SECONDS=8
USER_AGENT=FakeJobVerifierBot/1.0 (+https://fakejobverifier.local)
